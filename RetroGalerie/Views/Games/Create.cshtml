@using RetroGalerie.Services
@model RetroGalerie.Models.GameViewModel
@inject SharedLocalizationService Localizer

@{
    ViewData["Title"] = "Create";
}

<h1>@Localizer.Get("Create")</h1>

<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Create" enctype="multipart/form-data">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group">
                <label asp-for="Title" class="control-label">@Localizer.Get("Title")</label>
                <input asp-for="Title" class="form-control" />
                <span asp-validation-for="Title" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="YearOfPublication" class="control-label">@Localizer.Get("YearOfPublication")</label>
                <input asp-for="YearOfPublication" class="form-control" />
                <span asp-validation-for="YearOfPublication" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Description" class="control-label">@Localizer.Get("Description")</label>
                <textarea asp-for="Description" class="form-control"></textarea>
                <span asp-validation-for="Description" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="NumberOfPlayers" class="control-label">@Localizer.Get("NumberOfPlayers")</label>
                <input asp-for="NumberOfPlayers" class="form-control" />
                <span asp-validation-for="NumberOfPlayers" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="CoverImageFile" class="control-label">@Localizer.Get("CoverImageFile")</label>
                <input asp-for="CoverImageFile" type="file" class="form-control" />
                <span asp-validation-for="CoverImageFile" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Genre" class="control-label">@Localizer.Get("Genre")</label>
                <input asp-for="Genre" class="form-control" />
                <span asp-validation-for="Genre" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Developer" class="control-label">@Localizer.Get("Developer")</label>
                <input asp-for="Developer" class="form-control" />
                <span asp-validation-for="Developer" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Publisher" class="control-label">@Localizer.Get("Publisher")</label>
                <input asp-for="Publisher" class="form-control" />
                <span asp-validation-for="Publisher" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Region" class="control-label">@Localizer.Get("Region")</label>
                <input asp-for="Region" class="form-control" />
                <span asp-validation-for="Region" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Language" class="control-label">@Localizer.Get("Language")</label>
                <input asp-for="Language" class="form-control" />
                <span asp-validation-for="Language" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="ConsoleId" class="control-label">@Localizer.Get("Platform")</label>
                <select asp-for="ConsoleId" class="form-control" asp-items="ViewBag.ConsoleId"></select>
                <span asp-validation-for="ConsoleId" class="text-danger"></span>
            </div>
            <div class="form-group form-check mt-3">
                <input asp-for="Owned" class="form-check-input" type="checkbox" id="ownedToggle" />
                <label class="form-check-label" for="ownedToggle">@Localizer.Get("OwnedGame")</label>
            </div>

            <div class="form-group mt-3">
                <input type="submit" value="@Localizer.Get("Create")" class="btn btn-primary" />
                <a asp-action="Index" class="btn btn-secondary">@Localizer.Get("Back_to_List")</a>
            </div>
        </form>
    </div>
</div>


@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
