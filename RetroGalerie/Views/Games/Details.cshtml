@using RetroGalerie.Services
@model RetroGalerie.Models.GameViewModel
@inject SharedLocalizationService Localizer
@{
    ViewData["Title"] = "Details";
}

<h1 class="mb-3">
    @switch (Model.ConsoleName?.Trim().ToUpperInvariant())
    {
        case "NES":
            <img src="/images/logo/nes-logo.png" alt="NES Logo"
                 style="height:40px; vertical-align:middle; margin-right:10px;" />
            break;
        case "SNES":
            <img src="/images/logo/snes_logo.png" alt="SNES Logo"
                 style="height:40px; vertical-align:middle; margin-right:10px;" />
            break;
        case "GAME GEAR":
            <img src="/images/logo/Sega_Game_Gear_logo.png" alt="Game Gear Logo"
                 style="height:40px; vertical-align:middle; margin-right:10px;" />
            break;
        case "MEGADRIVE":
            <img src="/images/logo/Megadrive_logo.png" alt="Megadrive Logo"
                 style="height:40px; vertical-align:middle; margin-right:10px;" />
            break;
        case "XBOX 360":
            <img src="/images/logo/Xbox360_logo.png" alt="Xbox 360 Logo"
                 style="height:40px; vertical-align:middle; margin-right:10px;" />
            break;
        case "PLAYSTATION 2":
            <img src="/images/logo/PS2_Logo.png" alt="PS2 Logo"
                 style="height:40px; vertical-align:middle; margin-right:10px;" />
            break;
        case "NINTENDO 64":
            <img src="/images/logo/Nintendo64_logo.jpg" alt="Nintendo 64 Logo"
                 style="height:40px; vertical-align:middle; margin-right:10px;" />
            break;
    }
    @Model.Title
</h1>



<hr class="mb-4" /> <!-- Barre horizontale pleine largeur -->

<div class="row">
    <!-- Colonne gauche : infos textuelles -->
    <div class="col-md-6">
        <dl class="row">
            <dt class="col-sm-4">@Localizer.Get("Description")</dt>
            <dd class="col-sm-8">@Model.Description</dd>

            <dt class="col-sm-4">@Localizer.Get("YearOfPublication")</dt>
            <dd class="col-sm-8">@Model.YearOfPublication</dd>

            <dt class="col-sm-4">@Localizer.Get("NumberOfPlayers")</dt>
            <dd class="col-sm-8">@Model.NumberOfPlayers</dd>

            <dt class="col-sm-4">@Localizer.Get("Genre")</dt>
            <dd class="col-sm-8">@Model.Genre</dd>

            <dt class="col-sm-4">@Localizer.Get("Developer")</dt>
            <dd class="col-sm-8">@Model.Developer</dd>

            <dt class="col-sm-4">@Localizer.Get("Publisher")</dt>
            <dd class="col-sm-8">@Model.Publisher</dd>

            <dt class="col-sm-4">@Localizer.Get("Region")</dt>
            <dd class="col-sm-8">@Model.Region</dd>

            <dt class="col-sm-4">@Localizer.Get("Language")</dt>
            <dd class="col-sm-8">@Model.Language</dd>
        </dl>
    </div>

    <!-- Colonne droite : image -->
    <div class="col-md-6 d-flex justify-content-center align-items-start">
        <img src="@Model.CoverImageUrl" alt="@Model.Title"
             class="img-fluid shadow-lg rounded mb-3 @(Model.ConsoleName == "SNES" ? "cover-snes" : "cover-nes")" />
    </div>


</div>

<!-- Barre horizontale pleine largeur sous tout le contenu -->
<hr class="mt-4" />

<!-- Boutons alignés à droite sous la barre -->
<div class="text-end mt-3">
    <a asp-action="Edit" asp-route-id="@Model?.Id" class="btn btn-sm btn-warning">@Localizer.Get("Edit")</a>
    <a asp-action="Index" class="btn btn-sm btn-secondary">@Localizer.Get("Back_to_List")</a>
</div>
