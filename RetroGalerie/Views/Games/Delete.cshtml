@using RetroGalerie.Services
@model RetroGalerie.Models.GameViewModel
@inject SharedLocalizationService Localizer
@{
    ViewData["Title"] = "Delete";
}

<h1>@Localizer.Get("Delete")</h1>

<h3>@Localizer.Get("Delete_validation")</h3>
<div>
    <hr />
    <dl class="row">
        <dt class = "col-sm-2">
            @Localizer.Get("Title")
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Title)
        </dd>
        <dt class = "col-sm-2">
            @Localizer.Get("YearOfPublication")
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.YearOfPublication)
        </dd>
        <dt class = "col-sm-2">
            @Localizer.Get("Description")
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Description)
        </dd>
        <dt class = "col-sm-2">
            @Localizer.Get("NumberOfPlayers")
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.NumberOfPlayers)
        </dd>
        <dt class = "col-sm-2">
            @Localizer.Get("CoverImageFile")
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.CoverImageUrl)
        </dd>
        <dt class = "col-sm-2">
            @Localizer.Get("Genre")
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Genre)
        </dd>
        <dt class = "col-sm-2">
            @Localizer.Get("Developer")
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Developer)
        </dd>
        <dt class = "col-sm-2">
            @Localizer.Get("Publisher")
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Publisher)
        </dd>
        <dt class = "col-sm-2">
            @Localizer.Get("Region")
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Region)
        </dd>
        <dt class = "col-sm-2">
            @Localizer.Get("Language")
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Language)
        </dd>
        <dt class = "col-sm-2">
            @Localizer.Get("Platform")
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.ConsoleId)
        </dd>
    </dl>
    
    <form asp-action="Delete">
        <input type="hidden" asp-for="Id" />
        <input type="submit" value="@Localizer.Get("Delete")" class="btn btn-danger" /> |
        <a asp-action="Index" class="btn btn-secondary btn-sm">@Localizer.Get("Back_to_List")</a>
    </form>
</div>
