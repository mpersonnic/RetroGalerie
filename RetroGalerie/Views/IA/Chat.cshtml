@{
    Layout = "/Views/Shared/_LayoutIA.cshtml";
}

<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="utf-8" />
    <title>RetroGalerie IA</title>
    <style>
            body {
                background: #fdf6e3;
                color: #657b83;
                font-family: "Helvetica Neue", Helvetica, Arial, sans-serif;
            }

            .chat-header {
                background: #eee8d5;
                color: #657b83;
            }

            .bubble.ai {
                background: #eee8d5;
                color: #657b83;
            }

            .bubble.user {
                background: #268bd2;
                color: #fdf6e3;
            }

            .chat-messages {
                height: 320px;
                overflow-y: auto;
                padding: 10px;
            }

            .message-row {
                margin-bottom: 10px;
            }

            .bubble {
                padding: 8px 12px;
                border-radius: 8px;
                max-width: 90%;
            }
    </style>
</head>
<body>
    <div class="chat-container">
        <div class="chat-header">
            <h1>RetroGalerie IA</h1>
            <span>Chat en direct avec ton inventaire de jeux rétro</span>
            <br />
        </div>

        <div id="messages" class="chat-messages"></div>

        <div class="chat-input">
            <textarea id="input" rows="2" placeholder="Pose une question sur ta collection..."></textarea>
            <button id="send">Envoyer</button>
        </div>

        <br />
        <div class="status" id="status">Prêt.</div>
    </div>

    <script>
            const messagesEl = document.getElementById("messages");
            const inputEl = document.getElementById("input");
            const sendBtn = document.getElementById("send");
            const statusEl = document.getElementById("status");

            // 👉 On utilise le WebSocket global créé dans _LayoutIA via chat-socket.js
            const chatSocket = window.RetroGalerieSocket;

            function appendMessage(text, role) {
                const row = document.createElement("div");
                row.className = "message-row " + role;

                const bubble = document.createElement("div");
                bubble.className = "bubble " + role;
                bubble.textContent = text;

                row.appendChild(bubble);
                messagesEl.appendChild(row);
                messagesEl.scrollTop = messagesEl.scrollHeight;
            }

            // 👉 Réception des messages IA
            chatSocket.onMessage((msg) => {
                appendMessage(msg, "ai");
                statusEl.textContent = "Prêt.";
            });

            // 👉 Envoi des messages utilisateur
            sendBtn.addEventListener("click", () => {
                const q = inputEl.value.trim();
                if (!q) return;

                console.log("📤 Envoi du message");
                appendMessage(q, "user");
                inputEl.value = "";
                statusEl.textContent = "En cours...";
                chatSocket.send(q);
            });

            inputEl.addEventListener("keydown", (e) => {
                if (e.key === "Enter" && !e.shiftKey) {
                    e.preventDefault();
                    sendBtn.click();
                }
            });
    </script>
</body>
</html>
